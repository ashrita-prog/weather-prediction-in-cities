* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    background: linear-gradient(135deg, #74ebd5, #9face6);
}

.container {
    width: 90%;
    max-width: 500px;
    text-align: center;
}

h1 {
    color: white;
    margin-bottom: 25px;
}

.search-box {
    display: flex;
    gap: 10px;
    margin-bottom: 20px;
}

.search-box input {
    flex: 1;
    padding: 14px;
    border: none;
    border-radius: 8px;
    font-size: 16px;
    outline: none;
}

.search-box button {
    padding: 14px 20px;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    background: #333;
    color: white;
    font-size: 16px;
}

.search-box button:hover {
    background: #555;
}

.weather-card {
    background: rgba(255, 255, 255, 0.9);
    padding: 30px;
    border-radius: 20px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
}

.weather-card h2 {
    font-size: 28px;
    margin-bottom: 10px;
}

.weather-icon {
    font-size: 60px;
    margin: 10px;
}

#temperature {
    font-size: 40px;
    margin: 10px;
}

#description {
    text-transform: capitalize;
    font-size: 18px;
    margin-bottom: 25px;
}

.weather-details {
    display: flex;
    justify-content: space-around;
    gap: 10px;
}

.detail {
    background: #f2f2f2;
    padding: 15px;
    border-radius: 10px;
    flex: 1;
}

.detail span {
    font-size: 25px;
}

.detail p {
    margin: 8px 0;
    font-size: 14px;
}

.detail strong {
    font-size: 16px;
}

.error {
    color: #fff;
    background: #d9534f;
    padding: 10px;
    border-radius: 8px;
    margin-bottom: 15px;
    display: none;
}

.hidden {
    display: none;
}